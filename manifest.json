{
  "manifest_version": 3,
  "name": "unfollowed.exe",
  "version": "3.0",
  "description": "Determines who's not following you back on Instagram.",

  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "downloads",
    "sidePanel",
    "notifications"
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "side_panel": {
    "default_path": "popup.html"
  },

  "background": {
    "service_worker": "background.js"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": ["*://www.instagram.com/*"],
      "js": ["content.js"]
    }
  ]
}